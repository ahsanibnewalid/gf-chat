# GF Chat auth-admin backend environment template
# Copy this file to ".env" on your trusted computer and fill in the secret values.
# NEVER commit ".env" or paste its secret values into chat.
# Render does not automatically load a repository .env file; add/import these values
# into the Render service's Environment settings. Keep the real values in Render.

NODE_VERSION=20
PORT=10000

FIREBASE_PROJECT_ID=secretchatwithgf
FIREBASE_DATABASE_URL=https://secretchatwithgf-default-rtdb.asia-southeast1.firebasedatabase.app
ALLOWED_ORIGINS=https://ahsanibnewalid.github.io

# Comma-separated Firebase Authentication user UIDs allowed to administer settings.
ADMIN_UIDS=REPLACE_WITH_YOUR_FIREBASE_ADMIN_UID

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 64 hexadecimal characters (32 random bytes).
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_KEY

# Paste the full service-account JSON as ONE LINE, with JSON quotes escaped as needed
# for your dotenv parser. Prefer setting this value directly in Render to avoid parsing
# problems. Never commit the real service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
